# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# LLM API Configuration (например, polza.ai или OpenRouter)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.polza.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Database Configuration
DB_PATH=data/stories.db

# File Storage Configuration
IMAGES_BASE_PATH=data/images
MAX_IMAGE_SIZE_MB=5

# Story Settings (pairs of messages: user + assistant = 1 pair)
MAX_PAIRS_SHORT=5
MAX_PAIRS_MEDIUM=10
MAX_PAIRS_LONG=20

# Creativity Settings (LLM temperature)
CREATIVITY_LOW=0.5
CREATIVITY_MEDIUM=0.7
CREATIVITY_HIGH=0.9

# Message Limits
MAX_MESSAGE_LENGTH=500

# Logging
LOG_LEVEL=INFO

# Speech-to-Text API
SPEECH_API_KEY=your_speech_api_key
SPEECH_BASE_URL=https://api.polza.ai/api/v1
SPEECH_MODEL=whisper-1

# ============================================================================
# Optional: Image Generation API (for Iteration 16 - Story Covers)
# ============================================================================
# IMAGE_GEN_API_KEY=your_image_gen_api_key
# IMAGE_GEN_BASE_URL=https://api.polza.ai/api/v1
# IMAGE_GEN_MODEL=dall-e-3

# ============================================================================
# Optional: Vision API (for Iteration 17 - Image Upload for Inspiration)
# ============================================================================
# VISION_API_KEY=your_vision_api_key
# VISION_BASE_URL=https://api.polza.ai/api/v1
# VISION_MODEL=gpt-4o-mini