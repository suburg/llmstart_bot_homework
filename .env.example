# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# LLM API Key (например, OpenRouter API Key с openrouter.ai)
LLM_API_KEY=your_llm_api_key_here

# LLM Base URL (например, https://openrouter.ai/api/v1 для OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1

# LLM Model (по умолчанию openai/gpt-4o-mini)
LLM_MODEL=openai/gpt-4o-mini

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Story duration limits (pairs of messages)
MAX_PAIRS_SHORT=5
MAX_PAIRS_MEDIUM=10
MAX_PAIRS_LONG=20